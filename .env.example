DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kumite_arena?schema=public"
# Neon: pooled URL in DATABASE_URL. Do NOT keep channel_binding=require — Prisma cannot connect.
# DIRECT_URL = same Neon host without -pooler (for migrations)
DIRECT_URL=
JWT_SECRET="change-this-to-a-long-random-secret"
ADMIN_EMAIL="admin@kumite-arena.local"
ADMIN_PASSWORD="ChangeMe123!"
PORT=5000
CLIENT_URL="http://localhost:5173"
# Extra frontend origins, comma-separated (Vercel preview URLs)
CLIENT_URLS=
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5
NODE_ENV="development"
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=
TELEGRAM_ADMIN_CHAT_ID=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ADMIN_GATE=change-this-invite-code

# Frontend (Vercel → Environment Variables, must start with VITE_)
# VITE_API_URL=https://your-api.up.railway.app
